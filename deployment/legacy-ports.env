# Optional compatibility with install-sensenet.ps1's historical port calculation.
# Example, after preparing .env:
# docker compose --env-file .env --env-file legacy-ports.env -f docker-compose.with-auth.yml up -d
# This changes ports only. Keep each scenario's unique project/resources.
# Scenarios sharing legacy ports are alternatives; stop one before starting another.
SQL_PORT=9999
POSTGRES_PORT=5532
RABBIT_PORT=51005
LEGACY_INMEM_REPOSITORY_PORT=51011
LEGACY_INMEM_AUTH_PORT=51012
LEGACY_CONTAINER_REPOSITORY_PORT=51016
LEGACY_CONTAINER_AUTH_PORT=51017
LEGACY_HOST_REPOSITORY_PORT=51026
LEGACY_HOST_AUTH_PORT=51027
LEGACY_VOLUME_REPOSITORY_PORT=51036
LEGACY_VOLUME_AUTH_PORT=51037
LEGACY_HOST_VOLUME_REPOSITORY_PORT=51046
LEGACY_HOST_VOLUME_AUTH_PORT=51047
LEGACY_SEARCH_REPOSITORY_PORT=51056
LEGACY_SEARCH_AUTH_PORT=51057
LEGACY_SEARCH_SEARCH_PORT=51058
LEGACY_HOST_SEARCH_REPOSITORY_PORT=51066
LEGACY_HOST_SEARCH_AUTH_PORT=51067
LEGACY_HOST_SEARCH_SEARCH_PORT=51068
LEGACY_COMPLETE_REPOSITORY_PORT=51076
LEGACY_COMPLETE_AUTH_PORT=51077
