{
  "ConnectionStrings": {
    "SnCrMsSql": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Graylog" ],
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Properties": {
      "Application": "SnWebApplication.Api.Sql.LocalAuth",
      "Repository": ""
    }
  },
  "AllowedHosts": "*",
  "sensenet": {
    "authentication": {
      "authServerType": "IdentityServer",
      "authority": "https://localhost:44311",
      "repositoryUrl": "https://localhost:44372",
      "AddJwtCookie": false,
      "Local": { "Mode": "Disabled" }
    },
    "ApiKeys": {
      "HealthCheckerUser": ""
    },
    //"lucene29": {
    //  "IndexBackupDirectory": "App_Data\\IndexBackup"
    //},
    "Email": {
      "Server": "",
      "Port": 587
    },
    "Registration": {
      "Groups": [],
      "UserType": ""
    }
  }
}
