{
  "ConnectionStrings": {
    "SnCrMsSql": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Graylog" ],
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Properties": {
      "Application": "SnWebApplication.Api.Sql.TokenAuth",
      "Repository": ""
    }
  },
  "AllowedHosts": "*",
  "sensenet": {
    "contentNaming": {
      "RemoveDiacritics": false,
      "Lowercase": false,
      "Transliterate": false,
      "ApplyCustomReplacements": false,
      "ReplacementSources": [
        "ä", "Ä", "ß", "ẞ",
        "æ", "Æ", "œ", "Œ", "ø", "Ø", "ł", "Ł",
        "đ", "Đ", "ð", "Ð", "þ", "Þ", "ħ", "Ħ",
        "ı", "ĳ", "Ĳ", "ŋ", "Ŋ", "ŧ", "Ŧ", "ſ", "ŀ", "Ŀ",
        "&", " "
      ],
      "ReplacementTargets": [
        "ae", "AE", "ss", "SS",
        "ae", "AE", "oe", "OE", "o", "O", "l", "L",
        "d", "D", "d", "D", "th", "TH", "h", "H",
        "i", "ij", "IJ", "n", "N", "t", "T", "s", "l", "L",
        "and", "-"
      ]
    },
    "authentication": {
      "authServerType": "IdentityServer",
      "authority": "https://localhost:44311",
      "repositoryUrl": "https://localhost:44362",
      "AddJwtCookie": true
    },
    //"authentication": {
    //  "authServerType": "SNAuth",
    //  "authority": "https://localhost:7088",
    //  "repositoryUrl": "https://localhost:44362",
    //  "AddJwtCookie": false
    //},
    "ApiKeys": {
      "HealthCheckerUser": ""
    },
    //"lucene29": {
    //  "IndexBackupDirectory": "App_Data\\IndexBackup"
    //},
    "Email": {
      "Server": "",
      "Port": 587
    },
    "Registration": {
      "Groups": [],
      "UserType": ""
    }
  }
}
