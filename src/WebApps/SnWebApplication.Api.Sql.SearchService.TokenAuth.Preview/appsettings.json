{
  "ConnectionStrings": {
    "SnCrMsSql": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Graylog" ],
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Properties": {
      "Application": "SnWebApplication.Api.Sql.SearchService.TokenAuth.Preview",
      "Repository": ""
    }
  },
  "AllowedHosts": "*",
  "sensenet": {
    "contentNaming": {
      "RemoveDiacritics": false,
      "Lowercase": false,
      "Transliterate": false,
      "ApplyCustomReplacements": false,
      "ReplacementSources": [
        "ä", "Ä", "ö", "Ö", "ü", "Ü", "ß", "ẞ",
        "æ", "Æ", "œ", "Œ", "ø", "Ø", "ł", "Ł",
        "đ", "Đ", "ð", "Ð", "þ", "Þ", "ħ", "Ħ",
        "ı", "ĳ", "Ĳ", "ŋ", "Ŋ", "ŧ", "Ŧ", "ſ", "ŀ", "Ŀ",
        "&", " "
      ],
      "ReplacementTargets": [
        "ae", "AE", "oe", "OE", "ue", "UE", "ss", "SS",
        "ae", "AE", "oe", "OE", "o", "O", "l", "L",
        "d", "D", "d", "D", "th", "TH", "h", "H",
        "i", "ij", "IJ", "n", "N", "t", "T", "s", "l", "L",
        "and", "-"
      ]
    },
    "authentication": {
      "authServerType": "IdentityServer",
      "authority": "https://localhost:44311",
      "repositoryUrl": "https://localhost:44362",
      "AddJwtCookie": true
    },
    "ApiKeys": {
      "HealthCheckerUser": ""
    },
    "Email": {
      "Server": "",
      "Port": 587
    },
    "Registration": {
      "Groups": [],
      "UserType": ""
    },
    "search": {
      "service": {
        "ServiceAddress": "https://localhost:44322",
        "ValidateServerCertificate": false,
        "ServiceWritePartitionSize": 30,
        "ChannelOptions": {
          "MaxSendMessageSize": 4194304
        }
      }
    },
    "rabbitmq": {
      "ServiceUrl": ""
    },
    "security": {
      "rabbitmq": {
        "ServiceUrl": ""
      }
    },
    "Retrier": {
      "Count": 30,
      "WaitMilliseconds": 2000
    },
    "TaskManagement": {
      "Url": "https://localhost:56484",
      "ApplicationUrl": "https://localhost:44362",
      "ApplicationId": "localhost_44362",
      "ApiKeyExpirationHours": 24,
      "Authentication": {
        "Default": {
          "User": "builtin\\admin"
        }
      }
    },
    "AsposePreviewProvider": {
      "SkipLicenseCheck": false
    }
  }
}
