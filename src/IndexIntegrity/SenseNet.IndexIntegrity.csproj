<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Version>0.1.0-alpha.1</Version>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Company>Sense/Net Inc.</Company>
    <Product>sensenet Index Integrity</Product>
    <Description>Index integrity checks, reports, and targeted repairs for sensenet.</Description>
    <RepositoryUrl>https://github.com/SenseNet/sensenet.git</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="SenseNet.ODataTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ContentRepository\SenseNet.ContentRepository.csproj" />
    <ProjectReference Include="..\OData\SenseNet.OData.csproj" />
    <ProjectReference Include="..\Search\SenseNet.Search.csproj" />
    <ProjectReference Include="..\Storage\SenseNet.Storage.csproj" />
  </ItemGroup>

</Project>
